LIFX_TOKEN=""

# Time zone used to decide what "today" is for POST /nhl/watch/{team}.
# Containers default to UTC, where evening games fall on the next day.
TZ="America/Toronto"

# Minimum log level: DEBUG, INFO, WARN or ERROR. DEBUG adds a line for every
# score poll. Unset uses the build's default (INFO, or DEBUG for make build-debug).
# LOG_LEVEL="DEBUG"